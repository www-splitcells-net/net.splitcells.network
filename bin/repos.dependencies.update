#!/usr/bin/env sh
# SPDX-License-Identifier: EPL-2.0 OR GPL-2.0-or-later
# SPDX-FileCopyrightText: Contributors To The `net.splitcells.*` Projects

set -e

cd ../net.splitcells.network.bom
# These commands increase all dependencies by at most one version increment, if an update is available.
# This leads to more tests, but on the other hand makes it easier to understand, which version exactly introduced a problem.
# `mvn versions:use-next-releases -DprocessParent=true && mvn versions:update-properties -DprocessParent=true` is not used,
# as it is harder to update plugins that way.
# This is the case, because the versions plugin does not update plugins directly and the only way to do this,
# is to add every plugin as a dependency as well and link the dependency and plugin version via a property.
# Such a way would create additional XML code without a benefit and would decrease the readability of the BOM.
# TODO `-DartifactVersionSelectorSpec='next()'` does not seem to work correctly. It does not increment by one and cannot even find all updates: https://fosstodon.org/@splitcells/117416845997283388
mvn toolbox:versions -Dapply=true

cd ../net.splitcells.network.hub
mvn clean install # Check if the project can be build, after the update.

cd ../net.splitcells.network.bom
git diff --exit-code || git commit -sam "Update Maven dependencies and plugins #10"